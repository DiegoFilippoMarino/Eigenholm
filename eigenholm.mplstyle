# Figure house style for Eigenholm.
#
# Everything in this file used to be repeated inline in every plotting cell:
# spine removal, frameless legends, tight_layout, figure size, colors. It lives
# here so that the plotting code shown to a reader is only the part that says
# what is being drawn.
#
# Adopt it with a single line at the top of a page's first executable cell:
#
#     plt.style.use("../../eigenholm.mplstyle")
#
# Every content directory sits two levels below the project root, so that
# relative path is the same on every page.
#
# Colors track custom.scss: accent #2a6e6e, accent-secondary #5a6298, text
# #2b2b2f, border #e2e0dc. Figures are rendered once at build time as raster
# images and cannot follow the reader's light or dark theme, so the palette is
# chosen to stay legible on both.

# Color cycle: teal and indigo are the site accents; the rest extend them
# without leaving the muted editorial range.
axes.prop_cycle:      cycler('color', ['2a6e6e', '5a6298', 'b4653a', '7a8b3c', '9c4f6c', '65656d'])

# Frame: only the axes the reader needs to read values off.
axes.spines.top:      False
axes.spines.right:    False
axes.edgecolor:       2b2b2f
axes.linewidth:       0.8
axes.labelcolor:      2b2b2f
axes.titlecolor:      2b2b2f
axes.titlesize:       10.5
# Keep this at a weight the default font actually ships. "medium" resolves to a
# missing face and makes matplotlib log a findfont warning on every figure.
axes.titleweight:     normal
axes.titlepad:        8.0
axes.labelsize:       9.5
axes.grid:            False

# Legends sit inside the plot, so a box around them is one more line to ignore.
legend.frameon:       False
legend.fontsize:      9.0

xtick.color:          2b2b2f
ytick.color:          2b2b2f
xtick.labelsize:      8.5
ytick.labelsize:      8.5
xtick.direction:      out
ytick.direction:      out

grid.color:           e2e0dc
grid.linewidth:       0.6

lines.linewidth:      1.6
lines.markersize:     4.0

font.size:            9.5
mathtext.default:     regular

# autolayout replaces the tight_layout() call at the end of every cell.
figure.figsize:       8.8, 3.6
figure.dpi:           140
figure.autolayout:    True
figure.facecolor:     white
savefig.facecolor:    white
savefig.bbox:         standard
